# ─────────────────────────────────────────────
# Environment Variables Template
# Copy this to `.env` and fill in your values
# NEVER commit `.env` to version control
# ─────────────────────────────────────────────

# App
APP_NAME="Smart E-Commerce Analytics"
APP_ENV=development                  # development | staging | production
DEBUG=True
SECRET_KEY=your-secret-key-change-me-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
# SQLite (default for local dev)
DATABASE_URL=sqlite:///./ecommerce.db
# PostgreSQL (for production — uncomment and fill)
# DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_db

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=csv,xlsx

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ML
MODEL_DIR=app/ml/models
PREDICTION_DAYS=30

# ── Stripe billing (Step 2) ────────────────────────────────────
# Stripe Dashboard → Developers → API keys  (use TEST mode keys while developing)
STRIPE_SECRET_KEY=
# Printed by:  stripe listen --forward-to localhost:8000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Created for you by:  python scripts/setup_stripe.py
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# Where Stripe returns people after checkout (your React app)
FRONTEND_URL=http://localhost:5173

# ── Password-reset email (optional; leave SMTP_HOST blank in development) ──
# Without SMTP, the reset link is printed in the backend terminal instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=SalesIQ <no-reply@yourdomain.com>
